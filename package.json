{
  "name": "banca",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently -k -n api,cuentas,transf,shell -c gray,green,blue,magenta \"npm:api\" \"npm:start:cuentas\" \"npm:start:transferencias\" \"npm:start:shell\"",
    "start:shell": "ng serve banca",
    "start:cuentas": "ng serve mfe-cuentas",
    "start:transferencias": "ng serve mfe-transferencias",
    "api": "node scripts/preparar-api.mjs && json-server tmp/db.json --port 3000",
    "api:reset": "node scripts/preparar-api.mjs --reset",
    "build": "ng build mfe-cuentas && ng build mfe-transferencias && ng build banca",
    "watch": "ng build banca --watch --configuration development",
    "test": "ng test core --watch=false && ng test banca --watch=false && ng test mfe-cuentas --watch=false && ng test mfe-transferencias --watch=false && npm run test:scripts",
    "test:core": "ng test core",
    "test:shell": "ng test banca",
    "test:cuentas": "ng test mfe-cuentas",
    "test:transferencias": "ng test mfe-transferencias",
    "test:scripts": "vitest run --dir scripts --environment node",
    "desplegar:dev": "node scripts/preparar-despliegue.mjs dev",
    "desplegar:qas": "node scripts/preparar-despliegue.mjs qas",
    "desplegar:prod": "node scripts/preparar-despliegue.mjs prod"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/common": "~22.2.7",
    "@angular/compiler": "~22.2.7",
    "@angular/core": "~22.2.7",
    "@angular/forms": "~22.2.7",
    "@angular/platform-browser": "~22.2.7",
    "@angular/router": "~22.2.7",
    "rxjs": "~7.8.2",
    "tslib": "^2.9.1",
    "es-module-shims": "^2.8.4"
  },
  "devDependencies": {
    "@angular/build": "~22.2.8",
    "@angular/cli": "~22.2.8",
    "@angular/compiler-cli": "~22.2.7",
    "prettier": "^3.8.1",
    "typescript": "~6.0.3",
    "@angular-architects/native-federation": "~22.2.5",
    "vitest": "^5.1.1",
    "jsdom": "^31.0.1",
    "json-server": "1.0.0-beta.15",
    "concurrently": "^10.0.7",
    "@softarc/native-federation-orchestrator": "^4.10.2"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
